{% extends "@theme/layout.html.twig" %}

{% block title %}{{ post.title }} — {{ site.title }}{% endblock %}

{% block content %}
<article class="space-y-8">
    <div class="space-y-3">
        <span class="text-xs font-sans uppercase tracking-wider text-neutral-400">
            {{ post.published_at ? post.published_at|date('F j, Y') : 'Published' }}
        </span>
        <h1 class="text-3xl sm:text-5xl font-normal tracking-tight text-neutral-900 leading-tight">
            {{ post.title }}
        </h1>
    </div>

    <div class="text-lg text-neutral-800 leading-relaxed space-y-6 pt-6 border-t border-neutral-200">
        {{ post.content|raw }}
    </div>

    <div class="pt-8 border-t border-neutral-200 font-sans text-sm">
        <a href="/" class="text-neutral-900 hover:underline">&larr; Back to Journal</a>
    </div>
</article>
{% endblock %}
