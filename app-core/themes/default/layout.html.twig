<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{% block title %}{{ site.title|default('Modern CMS') }} — {{ site.tagline|default('Monolithic & Headless') }}{% endblock %}</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                        display: ['"Space Grotesk"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .glass { background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(16px); }
        .gradient-text { background: linear-gradient(135deg, #a5b4fc 0%, #818cf8 50%, #c084fc 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    </style>
    {% if headInjected is defined %}{{ headInjected|raw }}{% endif %}
    {% block head %}{% endblock %}
</head>
<body class="bg-slate-950 text-slate-100 font-sans antialiased min-h-screen flex flex-col selection:bg-brand-500 selection:text-white">
    <!-- Announcement Bar -->
    {% if theme.customizer.announcement_bar is defined and theme.customizer.announcement_bar %}
    <div class="bg-gradient-to-r from-indigo-900 via-purple-900 to-indigo-950 text-indigo-100 text-xs py-2 px-4 text-center font-medium border-b border-indigo-500/20">
        <span>✨ {{ theme.customizer.announcement_bar }}</span>
    </div>
    {% endif %}

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 w-full glass border-b border-slate-800/80 transition-all">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <a href="/" class="flex items-center space-x-3 group">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-purple-500 flex items-center justify-center shadow-lg shadow-brand-500/20 group-hover:scale-105 transition-transform">
                    <span class="font-display font-extrabold text-white text-xl">O</span>
                </div>
                <div>
                    <span class="font-display font-bold text-xl tracking-tight text-white group-hover:text-brand-100 transition-colors">{{ site.title|default('OpenSource eCommerce CMS') }}</span>
                    <span class="block text-[10px] text-slate-400 font-medium uppercase tracking-wider">{{ site.tagline|default('Alternative to WordPress') }}</span>
                </div>
            </a>

            <nav class="hidden md:flex items-center space-x-8 text-sm font-medium text-slate-300">
                <a href="/" class="hover:text-white transition-colors">Home</a>
                <a href="/shop" class="hover:text-white transition-colors">Shop</a>
                <a href="/#articles" class="hover:text-white transition-colors">Journal</a>
                <a href="/admin/sdui" target="_blank" class="flex items-center space-x-1.5 px-3 py-1 rounded-full bg-slate-800/80 border border-slate-700/50 text-indigo-300 hover:text-white hover:border-indigo-500/50 transition-all text-xs">
                    <span>📱 Android SDUI</span>
                </a>
            </nav>

            <div class="flex items-center space-x-3">
                <a href="/admin" class="text-xs font-semibold px-3.5 py-2 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 hover:border-slate-700 transition-all hidden sm:inline-flex items-center space-x-1.5">
                    <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    <span>Admin</span>
                </a>
                
                <!-- Dynamic Cart Button with Live Badge -->
                <button id="cart-nav-btn" onclick="window.CartManager.openDrawer()" class="relative p-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-200 border border-slate-800 hover:border-brand-500/50 transition-all flex items-center space-x-2 group">
                    <div class="relative">
                        <svg class="w-5 h-5 text-indigo-400 group-hover:text-indigo-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                        </svg>
                        <span id="cart-nav-badge" class="absolute -top-2.5 -right-2.5 bg-gradient-to-r from-pink-500 to-rose-500 text-white font-extrabold text-[10px] min-w-4 h-4 px-1 rounded-full flex items-center justify-center scale-0 transition-transform shadow-lg shadow-rose-500/30">0</span>
                    </div>
                    <span class="text-xs font-semibold text-slate-300 hidden sm:inline">Bag (<span id="cart-nav-total">$0.00</span>)</span>
                </button>

                <a href="/checkout" class="relative text-xs font-semibold px-4 py-2 rounded-xl bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white shadow-lg shadow-brand-600/30 transition-all flex items-center space-x-1.5">
                    <span>Checkout</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>
            </div>
        </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-grow">
        {% block content %}{% endblock %}
    </main>

    <!-- Storefront Footer -->
    <footer class="bg-slate-900 border-t border-slate-800/80 pt-16 pb-12 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
                <div class="md:col-span-2 space-y-4">
                    <div class="flex items-center space-x-3">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-600 to-purple-500 flex items-center justify-center">
                            <span class="font-display font-extrabold text-white text-base">O</span>
                        </div>
                        <span class="font-display font-bold text-lg text-white">{{ site.title|default('OpenSource eCommerce CMS') }}</span>
                    </div>
                    <p class="text-sm text-slate-400 max-w-sm">
                        {{ site.description|default(theme.customizer.footer_tagline|default('The modern, lightweight, monolithic & headless alternative to WordPress.')) }}
                    </p>
                    <div class="flex items-center space-x-2 text-xs text-slate-500">
                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span>cPanel Apache/LiteSpeed Zero-Terminal Ready</span>
                    </div>
                </div>

                <div>
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4 font-display">Navigation</h4>
                    <ul class="space-y-2.5 text-sm text-slate-400">
                        <li><a href="/" class="hover:text-white transition-colors">Storefront Home</a></li>
                        <li><a href="/shop" class="hover:text-white transition-colors">Product Catalog</a></li>
                        <li><a href="/checkout" class="hover:text-white transition-colors">Checkout</a></li>
                        <li><a href="/admin/sdui" target="_blank" class="hover:text-white transition-colors">Android SDUI Visual Studio</a></li>
                        <li><a href="/admin" class="hover:text-white transition-colors">Management Panel</a></li>
                    </ul>
                </div>

                <div>
                    <h4 class="text-sm font-semibold uppercase tracking-wider text-slate-200 mb-4 font-display">Architecture</h4>
                    <ul class="space-y-2.5 text-sm text-slate-400">
                        <li>Symfony 7 + PHP 8.2+</li>
                        <li>Inertia.js + Vue 3 SPA</li>
                        <li>Redis / File Fallback Cache</li>
                        <li>WordPress Hook Engine</li>
                    </ul>
                </div>
            </div>

            <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500">
                <p>&copy; {{ "now"|date("Y") }} {{ site.title|default('OpenSource eCommerce CMS') }}. Free and Open Source Under MIT License.</p>
                <p class="mt-4 sm:mt-0">OpenSource eCommerce CMS — Alternative to WordPress</p>
            </div>
        </div>
    </footer>

    <!-- Interactive Slide-Over Cart Drawer -->
    <div id="cart-drawer-backdrop" class="fixed inset-0 bg-slate-950/75 backdrop-blur-md z-50 opacity-0 pointer-events-none transition-opacity duration-300">
        <div id="cart-drawer-panel" class="absolute top-0 right-0 h-full w-full max-w-md bg-slate-900 border-l border-slate-800 shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out">
            <!-- Drawer Header -->
            <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-900/90 backdrop-blur-md">
                <div class="flex items-center space-x-2.5">
                    <div class="w-8 h-8 rounded-lg bg-brand-500/10 border border-brand-500/20 flex items-center justify-center text-brand-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-white text-base font-display">Shopping Bag</h3>
                        <p class="text-[11px] text-slate-400"><span id="cart-drawer-count">0</span> items selected</p>
                    </div>
                </div>
                <button onclick="window.CartManager.closeDrawer()" class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
            </div>

            <!-- Free Shipping Progress -->
            <div class="px-5 py-3 bg-slate-950/50 border-b border-slate-800 text-xs text-slate-300">
                <div class="flex justify-between items-center mb-1.5">
                    <span id="shipping-progress-text">Add $100 for FREE Shipping</span>
                    <span class="text-brand-400 font-bold" id="shipping-progress-status">Eligible over $100</span>
                </div>
                <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                    <div id="shipping-progress-bar" class="bg-gradient-to-r from-brand-500 to-emerald-400 h-full w-0 transition-all duration-300"></div>
                </div>
            </div>

            <!-- Drawer Items Scrollable Container -->
            <div id="cart-items-container" class="flex-1 overflow-y-auto p-5 space-y-4">
                <!-- Dynamically populated via CartManager -->
            </div>

            <!-- Drawer Footer -->
            <div id="cart-drawer-footer" class="p-5 border-t border-slate-800 bg-slate-900/90 space-y-4">
                <div class="space-y-1.5 text-xs text-slate-400">
                    <div class="flex justify-between">
                        <span>Subtotal</span>
                        <span id="cart-drawer-subtotal" class="font-bold text-white text-sm font-display">$0.00</span>
                    </div>
                    <div class="flex justify-between">
                        <span>Standard Shipping</span>
                        <span id="cart-drawer-shipping" class="text-slate-300">$15.00</span>
                    </div>
                    <div class="flex justify-between pt-2 border-t border-slate-800 text-sm font-bold text-white">
                        <span>Estimated Total</span>
                        <span id="cart-drawer-total" class="text-base text-brand-300 font-display">$0.00</span>
                    </div>
                </div>

                <div class="space-y-2">
                    <a href="/checkout" class="w-full py-3.5 px-4 rounded-xl bg-gradient-to-r from-brand-600 via-indigo-600 to-purple-600 hover:from-brand-500 hover:to-indigo-500 text-white font-bold text-sm text-center flex items-center justify-center space-x-2 shadow-xl shadow-brand-500/25 transition-all">
                        <span>Proceed to Checkout</span>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                    <button onclick="window.CartManager.closeDrawer()" class="w-full py-2.5 px-4 rounded-xl text-slate-400 hover:text-white hover:bg-slate-800/80 text-xs font-medium transition-colors">
                        Continue Shopping
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Floating Toast Notification -->
    <div id="cart-toast" class="fixed bottom-6 right-6 z-50 flex items-center space-x-3 p-3.5 rounded-2xl bg-slate-900/95 border border-brand-500/40 text-white shadow-2xl backdrop-blur-xl transform translate-y-24 opacity-0 transition-all duration-300 pointer-events-none max-w-sm">
        <img id="cart-toast-img" src="" alt="" class="w-10 h-10 rounded-xl object-cover border border-slate-700 shrink-0" />
        <div class="overflow-hidden">
            <span class="text-[10px] text-emerald-400 font-bold uppercase tracking-wider block">✓ Added to Shopping Bag</span>
            <p id="cart-toast-title" class="text-xs font-semibold text-white truncate max-w-[200px]"></p>
        </div>
        <button onclick="window.CartManager.openDrawer()" class="ml-2 px-2.5 py-1 rounded-lg bg-brand-600 hover:bg-brand-500 text-[11px] font-bold text-white shrink-0 pointer-events-auto">
            View
        </button>
    </div>

    <!-- Universal Cart Manager Engine -->
    <script>
    (function() {
        const STORAGE_KEY = 'ecommerce_cms_cart';

        const CartManager = {
            getItems: function() {
                try {
                    return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
                } catch (e) {
                    return [];
                }
            },
            saveItems: function(items) {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
                this.render();
                window.dispatchEvent(new CustomEvent('cart-changed', { detail: items }));
            },
            addItem: function(product) {
                if (!product || !product.id) return;
                const items = this.getItems();
                const existingIndex = items.findIndex(item => String(item.id) === String(product.id));

                if (existingIndex > -1) {
                    items[existingIndex].quantity = (items[existingIndex].quantity || 1) + (product.quantity || 1);
                } else {
                    items.push({
                        id: product.id,
                        title: product.title,
                        price: parseFloat(product.price || 0),
                        regular_price: parseFloat(product.regular_price || product.price || 0),
                        image: product.image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=600&q=80',
                        slug: product.slug || '',
                        sku: product.sku || '',
                        quantity: product.quantity || 1
                    });
                }

                this.saveItems(items);
                this.showToast(product.title, product.image);
            },
            updateQuantity: function(productId, delta) {
                const items = this.getItems();
                const item = items.find(i => String(i.id) === String(productId));
                if (item) {
                    item.quantity = (item.quantity || 1) + delta;
                    if (item.quantity <= 0) {
                        this.removeItem(productId);
                        return;
                    }
                    this.saveItems(items);
                }
            },
            removeItem: function(productId) {
                let items = this.getItems();
                items = items.filter(i => String(i.id) !== String(productId));
                this.saveItems(items);
            },
            clear: function() {
                this.saveItems([]);
            },
            getCount: function() {
                return this.getItems().reduce((sum, item) => sum + (item.quantity || 1), 0);
            },
            getSubtotal: function() {
                return this.getItems().reduce((sum, item) => sum + (item.price * (item.quantity || 1)), 0);
            },
            openDrawer: function() {
                const backdrop = document.getElementById('cart-drawer-backdrop');
                const panel = document.getElementById('cart-drawer-panel');
                if (backdrop && panel) {
                    backdrop.classList.remove('opacity-0', 'pointer-events-none');
                    backdrop.classList.add('opacity-100');
                    panel.classList.remove('translate-x-full');
                    panel.classList.add('translate-x-0');
                    this.render();
                }
            },
            closeDrawer: function() {
                const backdrop = document.getElementById('cart-drawer-backdrop');
                const panel = document.getElementById('cart-drawer-panel');
                if (backdrop && panel) {
                    backdrop.classList.remove('opacity-100');
                    backdrop.classList.add('opacity-0', 'pointer-events-none');
                    panel.classList.remove('translate-x-0');
                    panel.classList.add('translate-x-full');
                }
            },
            showToast: function(title, image) {
                const toast = document.getElementById('cart-toast');
                const toastTitle = document.getElementById('cart-toast-title');
                const toastImg = document.getElementById('cart-toast-img');
                if (toast && toastTitle) {
                    toastTitle.textContent = title;
                    if (toastImg) toastImg.src = image || 'https://images.unsplash.com/photo-1523275335684-37898b6baf30?auto=format&fit=crop&w=100&q=80';
                    toast.classList.remove('translate-y-24', 'opacity-0');
                    toast.classList.add('translate-y-0', 'opacity-100');
                    clearTimeout(this._toastTimer);
                    this._toastTimer = setTimeout(() => {
                        toast.classList.remove('translate-y-0', 'opacity-100');
                        toast.classList.add('translate-y-24', 'opacity-0');
                    }, 3500);
                }
            },
            render: function() {
                const count = this.getCount();
                const subtotal = this.getSubtotal();
                const shipping = subtotal >= 100 || count === 0 ? 0 : 15;
                const total = subtotal + shipping;

                // Update Navbar Badge
                const navBadge = document.getElementById('cart-nav-badge');
                const navTotal = document.getElementById('cart-nav-total');
                if (navBadge) {
                    navBadge.textContent = count;
                    if (count > 0) {
                        navBadge.classList.remove('scale-0');
                        navBadge.classList.add('scale-100');
                    } else {
                        navBadge.classList.remove('scale-100');
                        navBadge.classList.add('scale-0');
                    }
                }
                if (navTotal) {
                    navTotal.textContent = '$' + subtotal.toFixed(2);
                }

                // Update Drawer Elements
                const drawerCount = document.getElementById('cart-drawer-count');
                const drawerSubtotal = document.getElementById('cart-drawer-subtotal');
                const drawerShipping = document.getElementById('cart-drawer-shipping');
                const drawerTotal = document.getElementById('cart-drawer-total');
                const itemsContainer = document.getElementById('cart-items-container');
                const progressBar = document.getElementById('shipping-progress-bar');
                const progressText = document.getElementById('shipping-progress-text');
                const progressStatus = document.getElementById('shipping-progress-status');

                if (drawerCount) drawerCount.textContent = count;
                if (drawerSubtotal) drawerSubtotal.textContent = '$' + subtotal.toFixed(2);
                if (drawerShipping) drawerShipping.textContent = subtotal >= 100 || count === 0 ? 'FREE' : '$15.00';
                if (drawerTotal) drawerTotal.textContent = '$' + total.toFixed(2);

                if (progressBar && progressText && progressStatus) {
                    if (subtotal >= 100) {
                        progressBar.style.width = '100%';
                        progressText.textContent = '🎉 You unlocked FREE Shipping!';
                        progressStatus.textContent = 'Unlocked';
                    } else {
                        const pct = Math.min(100, Math.round((subtotal / 100) * 100));
                        progressBar.style.width = pct + '%';
                        progressText.textContent = `Add $${(100 - subtotal).toFixed(2)} more for FREE Shipping`;
                        progressStatus.textContent = `${pct}% reached`;
                    }
                }

                // Render Drawer Items List
                if (itemsContainer) {
                    const items = this.getItems();
                    if (items.length === 0) {
                        itemsContainer.innerHTML = `
                            <div class="h-64 flex flex-col items-center justify-center text-center p-6 text-slate-500">
                                <div class="w-16 h-16 rounded-2xl bg-slate-800/60 border border-slate-700/60 flex items-center justify-center text-slate-400 mb-3">
                                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                                </div>
                                <h4 class="text-white font-bold text-sm">Your Bag is Empty</h4>
                                <p class="text-xs text-slate-400 mt-1 max-w-[200px]">Discover our latest premium products and tech gear.</p>
                                <a href="/shop" onclick="window.CartManager.closeDrawer()" class="mt-4 px-4 py-2 rounded-xl bg-brand-600 hover:bg-brand-500 text-white text-xs font-semibold shadow-lg shadow-brand-500/20 transition-all">
                                    Explore Catalog
                                </a>
                            </div>
                        `;
                    } else {
                        itemsContainer.innerHTML = items.map(item => `
                            <div class="p-3.5 rounded-2xl bg-slate-950/60 border border-slate-800/80 flex items-center space-x-3.5 group hover:border-slate-700 transition-colors">
                                <img src="${item.image}" alt="${item.title}" class="w-16 h-16 rounded-xl object-cover bg-slate-900 border border-slate-800 shrink-0" />
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-bold text-white truncate group-hover:text-brand-300 transition-colors">${item.title}</h4>
                                    <p class="text-xs font-extrabold text-brand-400 mt-0.5">$${parseFloat(item.price).toFixed(2)}</p>
                                    <div class="flex items-center space-x-2 mt-2">
                                        <div class="flex items-center bg-slate-900 border border-slate-800 rounded-lg overflow-hidden">
                                            <button onclick="window.CartManager.updateQuantity(${item.id}, -1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 text-xs font-bold">-</button>
                                            <span class="w-6 text-center text-xs font-semibold text-white">${item.quantity || 1}</span>
                                            <button onclick="window.CartManager.updateQuantity(${item.id}, 1)" class="w-6 h-6 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-800 text-xs font-bold">+</button>
                                        </div>
                                        <button onclick="window.CartManager.removeItem(${item.id})" class="text-slate-500 hover:text-rose-400 p-1 text-xs transition-colors" title="Remove item">
                                            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="text-right shrink-0">
                                    <span class="text-xs font-extrabold text-white font-display">$${(parseFloat(item.price) * (item.quantity || 1)).toFixed(2)}</span>
                                </div>
                            </div>
                        `).join('');
                    }
                }
            }
        };

        window.CartManager = CartManager;

        // Close drawer on backdrop click
        document.addEventListener('DOMContentLoaded', function() {
            const backdrop = document.getElementById('cart-drawer-backdrop');
            if (backdrop) {
                backdrop.addEventListener('click', function(e) {
                    if (e.target === backdrop) {
                        CartManager.closeDrawer();
                    }
                });
            }
            CartManager.render();
        });

        // Sync when storage changes in another tab
        window.addEventListener('storage', function(e) {
            if (e.key === STORAGE_KEY) {
                CartManager.render();
            }
        });
    })();
    </script>

    {% if footerInjected is defined %}{{ footerInjected|raw }}{% endif %}
    {% block scripts %}{% endblock %}
</body>
</html>
